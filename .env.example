# Local development default: http://localhost:1337
# For desktop production builds, set this to your deployed API URL.
# Set to your Railway API domain for production web and desktop builds.
VITE_API_URL=http://localhost:1337
# Catalog/music fallback API (defaults to Liner's public API).
# VITE_CATALOG_API_URL=https://api.tryliner.fun
# Optional existing image proxy. Leave unset to load artwork directly.
VITE_COVERS_PROXY_URL=https://covers.tryliner.fun

LINER_DEV_SIGNING_SECRET=

# Standalone API local-development settings (never use the VITE_ prefix).
DATABASE_URL=
JWT_SECRET=
